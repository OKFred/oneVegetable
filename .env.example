ONE_VEGETABLE_API_PREFIX=/api/v1
ONE_VEGETABLE_ENVIRONMENT=local-node
# 可选：mock | replay | disabled | real；staging 使用 replay，production 固定 disabled
ONE_VEGETABLE_GATEWAY_MODE=mock
ONE_VEGETABLE_PORT=8787
ONE_VEGETABLE_SQLITE_PATH=.data/one-vegetable.sqlite
ONE_VEGETABLE_AUTO_MIGRATE=true
ONE_VEGETABLE_CORS_ORIGINS=http://localhost:5173
ONE_VEGETABLE_MUTATION_FLAGS=
ONE_VEGETABLE_REQUEST_RETENTION_DAYS=30
BOOTSTRAP_ADMIN_TOKEN=replace-with-a-long-one-time-secret
# 仅在 ONE_VEGETABLE_GATEWAY_MODE=real 时通过本机环境或 Worker Secret 设置：
#
ONE_VEGETABLE_ALIBABA_APP_KEY=
ONE_VEGETABLE_ALIBABA_APP_SECRET=
ONE_VEGETABLE_ALIBABA_ACCESS_TOKEN=
ONE_VEGETABLE_ALIBABA_ENDPOINT=https://eco.taobao.com/router/rest
ONE_VEGETABLE_ALIBABA_SIGN_METHOD=hmac

# 仅供本机 Playwright 登录 Alibaba 网站使用，不是 AppKey/AppSecret：
ALI_ACCOUNT=
ALL_PASS=
# OPEN_API_APP_KEY=
# OPEN_API_APP_NAME=
# OPEN_API_CALLBACK_URL=
# OPEN_API_MANUAL_FALLBACK=1

VITE_GATEWAY_MODE=mock
VITE_BFF_BASE_URL=http://localhost:8787
VITE_BFF_API_PREFIX=/api/v1
