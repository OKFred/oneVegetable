{
  "name": "one-vegetable",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0 <27",
    "pnpm": ">=11.20.0 <12"
  },
  "scripts": {
    "dev:web": "pnpm --filter @one-vegetable/web dev",
    "dev:extension": "pnpm --filter @one-vegetable/extension dev",
    "dev:api": "pnpm --filter @one-vegetable/api dev:node",
    "dev:api:real": "tsx scripts/run-real-api.ts",
    "dev:worker": "pnpm --filter @one-vegetable/api dev:worker",
    "openapi:auth": "tsx scripts/acquire-alibaba-openapi-auth.ts",
    "openapi:auth:refresh": "tsx scripts/refresh-alibaba-openapi-auth.ts",
    "db:migrate:local": "pnpm --filter @one-vegetable/api exec wrangler d1 migrations apply one-vegetable-local --local",
    "build:api": "pnpm --filter @one-vegetable/api build",
    "build": "pnpm run generate && pnpm -r --if-present build && pnpm run check:extension-bundle && pnpm run check:store-compliance",
    "build:web": "pnpm --filter @one-vegetable/web build",
    "build:extension": "pnpm --filter @one-vegetable/extension build",
    "check:extension-bundle": "tsx scripts/check-extension-bundle.ts",
    "check:store-compliance": "tsx scripts/check-store-compliance.ts",
    "check:workspace-version": "tsx scripts/check-workspace-version.ts",
    "capture:store-assets": "pnpm run build:extension && tsx scripts/capture-store-assets.ts",
    "zip:extension": "pnpm run release:extension",
    "release:extension": "pnpm run build:extension && pnpm run check:extension-bundle && pnpm run check:store-compliance && tsx scripts/package-extension.ts",
    "upload:extension:draft": "tsx scripts/upload-chrome-web-store-draft.ts",
    "generate": "pnpm run generate:version && pnpm run generate:privacy && pnpm run generate:product-contract && pnpm run generate:rfq-contract && pnpm run generate:trade-contract && pnpm run generate:logistics-contract && pnpm run generate:insights-contract && pnpm run generate:photo-contract && pnpm run generate:platform-contract && pnpm run generate:types && pnpm run generate:validators && pnpm run generate:mock-data",
    "generate:version": "tsx scripts/generate-version.ts",
    "generate:privacy": "tsx scripts/generate-privacy-pages.ts",
    "generate:product-contract": "tsx scripts/generate-product-contract.ts",
    "generate:rfq-contract": "tsx scripts/generate-rfq-contract.ts",
    "generate:trade-contract": "tsx scripts/generate-trade-contract.ts",
    "generate:logistics-contract": "tsx scripts/generate-logistics-contract.ts",
    "generate:insights-contract": "tsx scripts/generate-insights-contract.ts",
    "generate:photo-contract": "tsx scripts/generate-photo-contract.ts",
    "generate:platform-contract": "tsx scripts/generate-platform-contract.ts",
    "generate:types": "tsx scripts/generate-types.ts",
    "generate:validators": "tsx scripts/generate-validators.ts",
    "generate:mock-data": "tsx scripts/generate-mock-data.ts",
    "generate:check": "tsx scripts/generate-version.ts --check && tsx scripts/generate-privacy-pages.ts --check && tsx scripts/generate-product-contract.ts --check && tsx scripts/generate-rfq-contract.ts --check && tsx scripts/generate-trade-contract.ts --check && tsx scripts/generate-logistics-contract.ts --check && tsx scripts/generate-insights-contract.ts --check && tsx scripts/generate-photo-contract.ts --check && tsx scripts/generate-platform-contract.ts --check && tsx scripts/generate-types.ts --check && tsx scripts/generate-validators.ts --check && tsx scripts/generate-mock-data.ts --check",
    "check:openapi": "tsx scripts/check-redocly.ts && tsx scripts/check-openapi-quality.ts && pnpm run generate:check",
    "audit:apis": "tsx scripts/audit-alibaba-api.ts",
    "audit:apis:check": "tsx scripts/audit-alibaba-api.ts --check",
    "snapshot:product-docs": "tsx scripts/snapshot-product-docs.ts",
    "snapshot:rfq-docs": "tsx scripts/snapshot-rfq-docs.ts",
    "snapshot:trade-docs": "tsx scripts/snapshot-trade-docs.ts",
    "snapshot:logistics-docs": "tsx scripts/snapshot-logistics-docs.ts",
    "snapshot:insights-docs": "tsx scripts/snapshot-insights-docs.ts",
    "snapshot:photo-docs": "tsx scripts/snapshot-photo-docs.ts",
    "snapshot:platform-docs": "tsx scripts/snapshot-platform-docs.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:extension && playwright test",
    "test:e2e:bff-replay": "node scripts/prepare-bff-replay-e2e.mjs && playwright test --config playwright.bff-replay.config.ts",
    "smoke:local-auth": "node scripts/smoke-local-auth.mjs",
    "smoke:alibaba:real": "tsx scripts/smoke-alibaba-real.ts",
    "smoke:photobank:upload:real": "tsx scripts/smoke-photobank-upload-real.ts",
    "smoke:photobank:group:real": "tsx scripts/smoke-photobank-group-real.ts",
    "smoke:product:draft:real": "tsx scripts/smoke-product-draft-real.ts",
    "smoke:product:draft:verify": "tsx scripts/verify-product-draft-edit-real.ts",
    "smoke:product:mutations:real": "tsx scripts/smoke-product-mutations-real.ts",
    "smoke:product:display:real": "tsx scripts/smoke-product-display-lifecycle-real.ts",
    "recover:product:title:real": "tsx scripts/recover-product-title-real.ts",
    "smoke:web:real": "tsx scripts/prepare-real-web-smoke.ts && playwright test --config playwright.real.config.ts",
    "check:staging-config": "tsx scripts/check-staging-config.ts",
    "check:staging-config:local": "tsx scripts/check-staging-config.ts --allow-placeholders --skip-deployment-environment",
    "check:replay-coverage": "tsx scripts/check-documentation-replay.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run check:workspace-version && pnpm run check:openapi && pnpm run audit:apis:check && pnpm run check:replay-coverage && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.46.1",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "ajv": "8.20.0",
    "ajv-errors": "3.0.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "fflate": "0.8.3",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "linkedom": "0.18.13",
    "lint-staged": "17.3.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1"
  }
}
