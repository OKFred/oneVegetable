                "sku_value": false
              }
            ],
            "customize_image": false,
            "customize_value": false,
            "en_name": "demo",
            "input_type": "single_select",
            "required": false,
            "show_type": "check_box",
            "sku_attribute": false,
            "units": ["m", "cm"],
            "value_type": "string",
            "car_model": true
          }
        ]
      }
    },
    "alibaba.icbu.category.get.new": {
