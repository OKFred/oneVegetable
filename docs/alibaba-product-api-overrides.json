    "alibaba.icbu.category.attribute.get": {
      "reason": "官方响应示例将 child_attrs 与 units 数组包裹在 string 对象中，与参数表的 String[] 类型不一致。保留元素并移除示例包装。",
      "responseExample": {
        "attributes": [
          {
            "attr_id": 123,
            "attribute_values": [
              {
