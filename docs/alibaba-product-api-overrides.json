{
  "checkedAt": "2026-08-15",
  "overrides": {
    "alibaba.icbu.text.trans": {
      "reason": "2026-09-10 用户提供 TOP docId=67157 参数表。数组优先于 Java 单对象示例；query 仅允许 text。示例 app_name 是占位业务场景，不代表权限；success=true 与 error_code 同时出现的官方示例不能作为成功证据。",
      "requestSchemaPatches": {
        "/properties/icbu_translate_task_dto": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trans_engine",
              "target_language",
              "app_name",
              "source_text",
              "format",
              "field_type",
              "source_language"
            ],
            "properties": {
              "trans_engine": {
                "type": "string",
                "minLength": 1,
                "description": "翻译引擎名称"
              },
              "target_language": {
                "type": "string",
                "minLength": 1,
                "description": "目标语种"
              },
              "app_name": {
                "type": "string",
                "minLength": 1,
                "description": "业务场景 appName；示例不代表已获准的值"
              },
              "source_text": {
                "type": "string",
                "minLength": 1,
                "description": "需要翻译的内容"
              },
              "format": {
                "type": "string",
                "minLength": 1,
                "enum": ["text", "html"],
                "description": "html 或 text；query 仅支持 text"
              },
              "field_type": {
                "type": "string",
                "minLength": 1,
                "enum": ["query", "offer", "title", "message", "feedback"],
                "description": "query、offer、title、message、feedback"
              },
              "param_map": {
                "type": "string",
                "description": "业务透传参数（字符串）"
              },
              "source_language": {
                "type": "string",
                "minLength": 1,
                "description": "原始语种"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "field_type": {
                      "const": "query"
                    }
                  },
                  "required": ["field_type"]
                },
                "then": {
                  "properties": {
                    "format": {
                      "const": "text"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "responseExampleFile": "mock/data/text-trans.json",
      "requestExampleFile": "mock/data/text-trans.json"
    },
    "alibaba.icbu.category.attribute.get": {
      "reason": "官方响应示例将 child_attrs 与 units 数组包裹在 string 对象中，与参数表的 String[] 类型不一致。保留元素并移除示例包装。",
      "responseExample": {
        "attributes": [
          {
            "attr_id": 123,
            "attribute_values": [
              {
                "attr_value_id": 123,
                "child_attrs": ["123", "456"],
                "en_name": "type",
                "sku_value": false
              }
            ],
            "customize_image": false,
            "customize_value": false,
            "en_name": "demo",
            "input_type": "single_select",
            "required": false,
            "show_type": "check_box",
            "sku_attribute": false,
            "units": ["m", "cm"],
            "value_type": "string",
            "car_model": true
          }
        ]
      }
    },
    "alibaba.icbu.category.get.new": {
      "reason": "官方响应示例将 child_ids 与 parent_ids 包裹在 string 对象中，并把 JSON 数组括号混入元素文本；真实账号验证表明 child_ids 返回 Number[]，兼容保留 String。",
      "responseSchemaPatches": {
        "/properties/category/properties/child_ids/items": {
          "type": ["number", "string"]
        },
        "/properties/category/properties/parent_ids/items": {
          "type": ["number", "string"]
        }
      },
      "responseExample": {
        "category": {
          "category_id": 56,
          "child_ids": ["78", "90"],
          "leaf_category": false,
          "level": 2,
          "name": "Consumer Electronics",
          "parent_ids": ["12", "34"],
          "cn_name": "服装"
        }
      }
    },
    "alibaba.icbu.product.group.get": {
      "reason": "官方响应示例将 children_id_list 数组包裹在 number 对象中，与参数表 Number[] 类型不一致。保留数值并移除示例包装。",
      "responseExample": {
        "product_group": {
          "children_id_list": [788, 789],
          "group_id": 456,
          "group_name": "best seller",
          "parent_id": 123,
          "parent_id2": 11
        }
      }
    },
    "alibaba.icbu.product.schema.render": {
      "reason": "真实商品 ID 可能超出 JavaScript 安全整数范围；请求以十进制字符串无损传输，同时兼容文档 Number。",
      "requestSchemaPatches": {
        "/properties/param_product_top_publish_request/properties/product_id": {
          "type": ["number", "string"]
        }
      }
    },
    "alibaba.icbu.product.schema.render.draft": {
      "reason": "真实草稿商品 ID 可能超出 JavaScript 安全整数范围；请求以十进制字符串无损传输，同时兼容文档 Number。",
      "requestSchemaPatches": {
        "/properties/param_product_top_publish_request/properties/product_id": {
          "type": ["number", "string"]
        }
      }
    }
  }
}
